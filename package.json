{
  "name": "ureducator-platform-v2",
  "version": "0.1.0",
  "private": true,
  "description": "UrEducator 2.0 - UGC-NET preparation platform (greenfield build)",
  "workspaces": [
    "packages/*",
    "apps/*",
    "functions"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w @ureducator/shared && npm run build -w functions && npm run build -w web",
    "verify:bundle": "node scripts/verify-bundle.mjs apps/web/out",
    "test:rules": "node scripts/test-rules.mjs",
    "lint:rules": "node scripts/lint-rules.mjs",
    "prepare:deploy": "node scripts/prepare-deploy.mjs",
    "verify:functions": "node scripts/verify-bundle.mjs functions/lib dist/functions",
    "test:rules:run": "vitest run --config tests/rules/vitest.config.ts",
    "verify:config": "node scripts/verify-staging-config.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@firebase/rules-unit-testing": "6.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "firebase-tools": "15.34.2",
    "globals": "17.14.0",
    "typescript-eslint": "8.72.1"
  }
}
