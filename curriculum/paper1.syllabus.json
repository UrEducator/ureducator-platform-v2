          "page": 6,
          "sourceDocId": "ugc-net-paper1-english-dec2026"
        },
        {
          "statementNo": 3,
          "id": "U6.3",
          "text": {
            "en": "Analogies."
          },
          "page": 6,
          "sourceDocId": "ugc-net-paper1-english-dec2026"
        },
        {
          "statementNo": 4,
          "id": "U6.4",
          "text": {
            "en": "Venn diagram: Simple and multiple use for establishing validity of arguments."
          },
          "page": 6,
          "sourceDocId": "ugc-net-paper1-english-dec2026"
        },
        {
          "statementNo": 5,
          "id": "U6.5",
          "text": {
            "en": "Indian Logic: Means of knowledge."
