  "units": [
    {
      "unitNo": 1,
      "unitId": "U1",
      "canonicalNumber": 1,
      "title": {
        "en": "Teaching Aptitude"
      },
      "statements": [
        {
          "statementNo": 1,
          "id": "U1.1",
          "text": {
            "en": "Teaching: Concept, Objectives, Levels of teaching (Memory, Understanding and Reflective), Characteristics and basic requirements."
          },
          "page": 1,
          "sourceDocId": "ugc-net-paper1-english-dec2026"
        },
        {
          "statementNo": 2,
          "id": "U1.2",
          "text": {
            "en": "Learner's characteristics: Characteristics of adolescent and adult learners (Academic, Social, Emotional and Cognitive), Individual differences."
          },
          "page": 1,
          "sourceDocId": "ugc-net-paper1-english-dec2026"
        },
        {
          "statementNo": 3,
          "id": "U1.3",
          "text": {
            "en": "Factors affecting teaching related to: Teacher, Learner, Support material, Instructional facilities, Learning environment and Institution."
          },
          "page": 1,
          "sourceDocId": "ugc-net-paper1-english-dec2026"
        },
        {
          "statementNo": 4,
          "id": "U1.4",
          "text": {
            "en": "Methods of teaching in Institutions of higher learning: Teacher centred vs. Learner centred methods; Off-line vs. On-line methods (Swayam, Swayamprabha, MOOCs etc.)."
          },
          "page": 1,
          "sourceDocId": "ugc-net-paper1-english-dec2026"
        },
        {
          "statementNo": 5,
          "id": "U1.5",
          "text": {
            "en": "Teaching Support System: Traditional, Modern and ICT based."
          },
          "page": 1,
          "sourceDocId": "ugc-net-paper1-english-dec2026"
        },
        {
          "statementNo": 6,
          "id": "U1.6",
          "text": {
            "en": "Evaluation Systems: Elements and Types of evaluation, Evaluation in Choice Based Credit System in Higher education, Computer based testing, Innovations in evaluation systems."
          },
          "page": 1,
          "sourceDocId": "ugc-net-paper1-english-dec2026"
        }
      ]
    },
    {
