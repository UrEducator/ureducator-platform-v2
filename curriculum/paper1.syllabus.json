          "page": 6,
          "sourceDocId": "ugc-net-paper1-english-dec2026"
        },
        {
          "statementNo": 6,
          "id": "U6.6",
          "text": {
            "en": "Pramanas: Pratyaksha (Perception), Anumana (Inference), Upamana (Comparison), Shabda (Verbal testimony), Arthapatti (Implication) and Anupalabddhi (Non-apprehension)."
          },
          "page": 6,
          "sourceDocId": "ugc-net-paper1-english-dec2026"
        },
        {
          "statementNo": 7,
          "id": "U6.7",
          "text": {
            "en": "Structure and kinds of Anumana (inference), Vyapti (invariable relation), Hetvabhasas (fallacies of inference)."
          },
          "page": 6,
          "sourceDocId": "ugc-net-paper1-english-dec2026"
        }
      ]
